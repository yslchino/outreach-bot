# Copy to .env. Integrations are off by default.
PORT=5000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27018/outreach_v2_dev
ALLOW_REMOTE_DATABASE=false
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_ORIGIN=http://127.0.0.1:5173
SENDING_ENABLED=false
JOBS_ENABLED=false
EMAIL_PROVIDER=disabled
EMAIL_FROM=
EMAIL_REPLY_TO=
REPLY_PROVIDER=manual
RESEND_RECEIVING_ADDRESS=
RESEND_RECEIVING_ENABLED=false
POSTAL_ADDRESS=
DAILY_SEND_LIMIT=25
BUSINESS_TIMEZONE=America/Los_Angeles
AI_ENABLED=false
MONTHLY_AI_DRAFT_LIMIT=100
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Select a provider that permits your recipient type before enabling SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_OUTREACH_APPROVED=false
# Set true only after Resend approves business-contact outreach for your account.
# This does not enable sending or change recipient permission categories.
RESEND_OUTREACH_APPROVED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/auth/gmail/callback
GMAIL_REFRESH_TOKEN=
# Outlook reply inbox: Microsoft app supporting personal Microsoft accounts.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://127.0.0.1:5000/api/outlook/callback
OUTLOOK_EXPECTED_EMAIL=
# Separate encryption key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OUTLOOK_TOKEN_KEY=
# Used only by npm run bootstrap-admin.
BOOTSTRAP_USERNAME=
BOOTSTRAP_DISPLAY_NAME=
BOOTSTRAP_PASSWORD=
